{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map: companies entering external administration for the first time, FY2025–26 (ASIC Series 1).",
  "width": "container",
  "height": 430,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132.5,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e9e2d4",
        "stroke": "#faf7f2",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "data/states_2026.csv",
        "format": {
          "type": "csv",
          "parse": {
            "label_lon": "number",
            "label_lat": "number",
            "hex_col": "number",
            "hex_row": "number",
            "businesses_jun2026": "number",
            "population_mar2026": "number",
            "businesses_per_1000": "number",
            "growth_pct_2025_26": "number",
            "survival_jun22_jun26": "number",
            "insolvencies_fy2025_26": "number",
            "insolvencies_per_10000": "number",
            "entry_rate": "number",
            "exit_rate": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "color": "#c0532b",
        "opacity": 0.78,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_lat",
          "type": "quantitative"
        },
        "size": {
          "field": "insolvencies_fy2025_26",
          "type": "quantitative",
          "title": "Companies entering insolvency, 2025–26",
          "scale": {
            "type": "linear",
            "zero": true,
            "domain": [
              0,
              5500
            ],
            "range": [
              0,
              4000
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              500,
              2000,
              5000
            ],
            "symbolFillColor": "#c0532b",
            "symbolStrokeColor": "#fff"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State/territory"
          },
          {
            "field": "businesses_jun2026",
            "title": "Businesses (June 2026)",
            "format": ","
          },
          {
            "field": "businesses_per_1000",
            "title": "Businesses per 1,000 residents",
            "format": ".1f"
          },
          {
            "field": "growth_pct_2025_26",
            "title": "Growth 2025–26 (%)",
            "format": ".1f"
          },
          {
            "field": "insolvencies_fy2025_26",
            "title": "Companies entering insolvency 2025–26",
            "format": ","
          },
          {
            "field": "insolvencies_per_10000",
            "title": "Per 10,000 businesses",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/states_2026.csv",
        "format": {
          "type": "csv",
          "parse": {
            "label_lon": "number",
            "label_lat": "number",
            "hex_col": "number",
            "hex_row": "number",
            "businesses_jun2026": "number",
            "population_mar2026": "number",
            "businesses_per_1000": "number",
            "growth_pct_2025_26": "number",
            "survival_jun22_jun26": "number",
            "insolvencies_fy2025_26": "number",
            "insolvencies_per_10000": "number",
            "entry_rate": "number",
            "exit_rate": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.abbr + ' ' + format(datum.insolvencies_fy2025_26, ',')",
          "as": "lab"
        },
        {
          "calculate": "datum.abbr === 'ACT' ? datum.label_lat - 1.6 : datum.abbr === 'TAS' ? datum.label_lat - 2.2 : datum.insolvencies_fy2025_26 > 2000 ? datum.label_lat : datum.label_lat + 1.9",
          "as": "lab_lat"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 700
      },
      "encoding": {
        "longitude": {
          "field": "label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lab_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        },
        "color": {
          "condition": {
            "test": "datum.insolvencies_fy2025_26 > 2000",
            "value": "#ffffff"
          },
          "value": "#1d3540"
        }
      }
    }
  ]
}